{
  "name": "AuraRush",
  "serveAddress": "127.0.0.1",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "AuraRushLoading": {
        "$path": "src/replicatedFirst/Loading.client.lua"
      }
    },
    "ReplicatedStorage": {
      "AuraRushShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "AuraRushServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 18,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "AuraRushClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 256,
        "Gravity": 196.2
      }
    }
  }
}
